# Google AI Studio API key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=your_api_key_here
# Model to use (change it if Google renames or retires it)
GEMINI_MODEL=gemini-3.5-flash
# Code required to open the chat page
ACCESS_CODE=change_this_code
# Folder with your PDFs (default: ./articles)
# ARTICLES_DIR=./articles
